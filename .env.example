# ─── No API keys required — everything runs locally ──────────────────────────

# ─── ASR Settings ─────────────────────────────────────────────────────────────
# Whisper model size (downloaded automatically from HuggingFace on first run).
# Choices: tiny.en | base.en | small.en | medium.en | large-v3
# tiny.en  → fastest (~39 MB)
# base.en  → good balance (~74 MB)  ← default
# small.en → better accuracy (~244 MB)
WHISPER_MODEL=base.en

# Device for faster-whisper: "cpu" | "cuda" | "auto"
WHISPER_DEVICE=auto

# Comma-separated technical hotwords biased into Whisper's beam search.
# These terms are also automatically registered as custom protected entities
# so the MT model never translates them.
ASR_HOTWORDS=Asterisk,Twilio,WebRTC,ETA,SIP,VoIP,Google Meet,Zoom,GitHub,Jira

# ASR confidence thresholds — segments outside these ranges are dropped.
# no_speech_prob: probability that a segment is silence/noise (0–1, lower = stricter)
ASR_NO_SPEECH_THRESHOLD=0.6
# avg_logprob: average log-probability of tokens (negative; more negative = worse)
ASR_LOW_CONFIDENCE_LOGPROB=-1.0

# ─── Translation Settings ─────────────────────────────────────────────────────
# Translation model: facebook/nllb-200-distilled-600M (~1.2 GB)
TRANSLATION_BACKEND=nllb

# Device for translation model: "cpu" | "cuda" | "auto"
TRANSLATION_DEVICE=auto

# Hindi tone: "formal" | "casual" | "auto"
# auto → inferred from sentence structure
HINDI_TONE=auto

# ─── TTS Settings — piper-tts (local neural TTS) ─────────────────────────────
# Voice name — downloaded automatically on first run from HuggingFace.
# Available Hindi voices (rhasspy/piper-voices on HuggingFace):
#   hi_IN-rohan-medium      (male,   ~63 MB)  ← default
#   hi_IN-pratham-medium    (male,   ~63 MB)
#   hi_IN-priyamvada-medium (female, ~63 MB)
PIPER_VOICE=hi_IN-rohan-medium

# Directory where piper voice model files are stored.
# Defaults to ~/.local/share/voicebot/voices/
PIPER_VOICES_DIR=

# Speaking rate multiplier (1.0 = normal, 0.9 = slightly slower)
PIPER_SPEED=1.0

# ─── VAD Settings ─────────────────────────────────────────────────────────────
# WebRTC VAD aggressiveness: 0 (least) → 3 (most)
VAD_AGGRESSIVENESS=2

# Silence duration to end a speech segment (ms)
SILENCE_DURATION_MS=800

# Minimum speech duration to trigger ASR (ms)
MIN_SPEECH_DURATION_MS=300

# ─── Audio Settings ───────────────────────────────────────────────────────────
# Sample rate — Whisper expects 16000
SAMPLE_RATE=16000

# Input device index (-1 = system default)
INPUT_DEVICE=-1
